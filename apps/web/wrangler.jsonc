{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skateboardordie",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-25",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "routes": [
    { "pattern": "skateboardordie.com", "custom_domain": true },
    { "pattern": "www.skateboardordie.com", "custom_domain": true }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "skateboardordie"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["crew@mailer.skateboardordie.com"]
    }
  ],
  // Per-IP limit on the sign-in endpoints (keys are "<route>:<ip>").
  "ratelimits": [
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "skateboardordie-waitlist",
      "database_id": "ce8785b7-ca29-41da-9ad7-afe4330bde2c",
      "migrations_dir": "migrations"
    }
  ]
}
